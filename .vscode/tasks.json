{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile C++ (cmd)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-o",
        "${workspaceFolder}\\cpp\\build\\${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run C++ with I/O",
      "type": "shell",
      "command": "${workspaceFolder}\\cpp\\build\\${fileBasenameNoExtension}.exe < ${workspaceFolder}\\cpp\\test_data\\input.txt > ${workspaceFolder}\\cpp\\test_data\\output.txt",
      "options": {
        "cwd": "${fileDirname}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "dependsOn": "Compile C++ (cmd)"
    }
  ]
}
